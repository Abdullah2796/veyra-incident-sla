{
  "name": "VeyraTheme",
  "dataColors": [
    "#6A4FD6",
    "#13294B",
    "#E8A33D",
    "#2E9E6A",
    "#D64545",
    "#8A94A6",
    "#B9AEF0",
    "#5B7DB1"
  ],
  "background": "#FFFFFF",
  "foreground": "#13294B",
  "tableAccent": "#6A4FD6",
  "good": "#2E9E6A",
  "neutral": "#E8A33D",
  "bad": "#D64545",
  "maximum": "#6A4FD6",
  "center": "#E8A33D",
  "minimum": "#D64545",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#13294B"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#13294B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#13294B"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6B7689"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1E6ED"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#13294B"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#6B7689"
              }
            },
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6B7689"
              }
            },
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#6B7689"
              }
            },
            "position": "Top"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#13294B"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#13294B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F7F9FB"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "grid": [
          {
            "rowPadding": 4,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#13294B"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FAFBFC"
              }
            }
          }
        ]
      }
    }
  }
}