table '_Measures'

	/// Latest incident timestamp in the export; anchors ageing.
	measure 'As Of' = CALCULATE ( MAX ( FactIncident[Opened At] ), REMOVEFILTERS () )
		formatString: d mmm yyyy hh:nn
		displayFolder: Volume

	measure 'Incidents' = COUNTROWS ( FactIncident )
		formatString: #,0
		displayFolder: Volume

	measure 'P1 Incidents' = CALCULATE ( [Incidents], FactIncident[Priority] = "P1" )
		formatString: #,0
		displayFolder: Volume

	measure 'Auto-detected %' = DIVIDE ( CALCULATE ( [Incidents], FactIncident[Channel] = "Auto-monitoring" ), [Incidents] )
		formatString: 0.0%
		displayFolder: Volume

	/// Incident rate normalised by installed devices.
	measure 'Incidents per 1k Devices' = DIVIDE ( [Incidents], SUM ( DimSite[Devices] ) ) * 1000
		formatString: #,0.0
		displayFolder: Volume

	measure 'Incidents MoM %' = ```
			VAR Prev = CALCULATE ( [Incidents], DATEADD ( DimDate[Date], -1, MONTH ) )
			RETURN DIVIDE ( [Incidents] - Prev, Prev )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Volume

	measure 'Release-linked Incidents' = CALCULATE ( [Incidents], FactIncident[Release] <> "" )
		formatString: #,0
		displayFolder: Volume

	measure 'Resolved Incidents' = CALCULATE ( [Incidents], NOT ISBLANK ( FactIncident[Resolution Met] ) )
		formatString: #,0
		displayFolder: SLA

	measure 'Response SLA %' = DIVIDE ( CALCULATE ( [Incidents], FactIncident[Response Met] = TRUE () ), CALCULATE ( [Incidents], NOT ISBLANK ( FactIncident[Response Met] ) ) )
		formatString: 0.0%
		displayFolder: SLA

	/// Share of resolved incidents fixed within the resolution target for their priority.
	measure 'Resolution SLA %' = DIVIDE ( CALCULATE ( [Incidents], FactIncident[Resolution Met] = TRUE () ), [Resolved Incidents] )
		formatString: 0.0%
		displayFolder: SLA

	measure 'SLA Breaches' = CALCULATE ( [Incidents], FactIncident[Resolution Met] = FALSE () )
		formatString: #,0
		displayFolder: SLA

	measure 'Median Response (min)' = MEDIAN ( FactIncident[Response Minutes] )
		formatString: #,0.0
		displayFolder: SLA

	measure 'Median Resolution (hrs)' = MEDIAN ( FactIncident[Resolution Hours] )
		formatString: #,0.0
		displayFolder: SLA

	/// 90th percentile: the slowest 10% of incidents take longer than this.
	measure 'P90 Resolution (hrs)' = PERCENTILEX.INC ( FILTER ( FactIncident, NOT ISBLANK ( FactIncident[Resolution Hours] ) ), FactIncident[Resolution Hours], 0.9 )
		formatString: #,0.0
		displayFolder: SLA

	measure 'Reopen Rate %' = DIVIDE ( CALCULATE ( [Incidents], FactIncident[Reopened] = TRUE () ), [Resolved Incidents] )
		formatString: 0.0%
		displayFolder: SLA

	measure 'Open Incidents' = CALCULATE ( [Incidents], FactIncident[Is Open] = TRUE () )
		formatString: #,0
		displayFolder: Backlog

	/// Open incidents already older than their resolution target.
	measure 'Aged Backlog' = CALCULATE ( [Incidents], FactIncident[Is Aged] = TRUE () )
		formatString: #,0
		displayFolder: Backlog

	measure 'Aged Backlog %' = DIVIDE ( [Aged Backlog], [Open Incidents] )
		formatString: 0.0%
		displayFolder: Backlog

	measure 'Avg Age Open (days)' = DIVIDE ( CALCULATE ( AVERAGE ( FactIncident[Age Hours] ), FactIncident[Is Open] = TRUE () ), 24 )
		formatString: #,0.0
		displayFolder: Backlog

	measure 'Survey Responses' = CALCULATE ( COUNTROWS ( FactCSAT ), FactCSAT[Has Incident] = TRUE () )
		formatString: #,0
		displayFolder: Customer

	/// Average survey score, 1–5.
	measure 'CSAT' = CALCULATE ( AVERAGE ( FactCSAT[Score] ), FactCSAT[Has Incident] = TRUE () )
		formatString: 0.00
		displayFolder: Customer

	measure 'Satisfied %' = DIVIDE ( CALCULATE ( [Survey Responses], FactCSAT[Score] >= 4 ), [Survey Responses] )
		formatString: 0.0%
		displayFolder: Customer

	measure 'Survey Response Rate' = DIVIDE ( [Survey Responses], [Resolved Incidents] )
		formatString: 0.0%
		displayFolder: Customer

	measure 'KPI Actual' = ```
			SWITCH (
			    SELECTEDVALUE ( 'KPI Targets'[KPI Key] ),
			    "RES_SLA", [Resolution SLA %],
			    "RESP_SLA", [Response SLA %],
			    "REOPEN", [Reopen Rate %],
			    "CSAT", [CSAT],
			    "AGED", [Aged Backlog %]
			)
			```
		formatString: 0.000
		displayFolder: Scorecard

	measure 'KPI Target' = SELECTEDVALUE ( 'KPI Targets'[Target] )
		formatString: 0.000
		displayFolder: Scorecard

	measure 'KPI Actual (display)' = ```
			VAR v = [KPI Actual]
			RETURN IF ( ISBLANK ( v ), BLANK (), IF ( SELECTEDVALUE ( 'KPI Targets'[KPI Key] ) = "CSAT", FORMAT ( v, "0.00" ), FORMAT ( v, "0.0%" ) ) )
			```
		formatString: General
		displayFolder: Scorecard

	measure 'KPI Target (display)' = ```
			VAR v = [KPI Target]
			RETURN IF ( ISBLANK ( v ), BLANK (), IF ( SELECTEDVALUE ( 'KPI Targets'[KPI Key] ) = "CSAT", FORMAT ( v, "0.00" ), FORMAT ( v, "0.0%" ) ) )
			```
		formatString: General
		displayFolder: Scorecard

	measure 'KPI Status' = ```
			VAR Actual = [KPI Actual]
			VAR Target = [KPI Target]
			VAR HigherIsBetter = SELECTEDVALUE ( 'KPI Targets'[Direction] ) = "Higher is better"
			VAR OnTarget = IF ( HigherIsBetter, Actual >= Target, Actual <= Target )
			VAR NearTarget = IF ( HigherIsBetter, Actual >= Target * 0.95, Actual <= Target * 1.10 )
			RETURN IF ( ISBLANK ( Actual ), BLANK (), IF ( OnTarget, "● On target", IF ( NearTarget, "● Watch", "● Off target" ) ) )
			```
		formatString: General
		displayFolder: Scorecard

	measure 'KPI Score' = ```
			VAR Actual = [KPI Actual]
			VAR Target = [KPI Target]
			VAR Ratio = IF ( SELECTEDVALUE ( 'KPI Targets'[Direction] ) = "Higher is better", DIVIDE ( Actual, Target ), DIVIDE ( Target, Actual ) )
			RETURN MIN ( 1, Ratio ) * SELECTEDVALUE ( 'KPI Targets'[Weight] )
			```
		formatString: 0.0%
		displayFolder: Scorecard

	measure 'Overall Score' = SUMX ( VALUES ( 'KPI Targets'[KPI Key] ), [KPI Score] )
		formatString: 0.0%
		displayFolder: Scorecard

	measure 'Report Subtitle' = "Synthetic data · status as of " & FORMAT ( [As Of], "d mmm yyyy" )
		formatString: General
		displayFolder: Labels

	measure 'SLA Headline' = ```
			VAR Weakest = TOPN ( 1, FILTER ( VALUES ( DimGroup[Group] ), NOT ISBLANK ( [Resolution SLA %] ) ), [Resolution SLA %], ASC )
			VAR WName = MAXX ( Weakest, DimGroup[Group] )
			VAR WRate = MAXX ( Weakest, [Resolution SLA %] )
			RETURN "Resolution SLA " & FORMAT ( [Resolution SLA %], "0.0%" ) & " against a 90% target  ·  weakest resolver: " & WName & " (" & FORMAT ( WRate, "0.0%" ) & ")"
			```
		formatString: General
		displayFolder: Labels

	column Dummy
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Dummy

	partition '_Measures' = m
		mode: import
		source =
				let
				    Source = #table(type table [Dummy = text], {})
				in
				    Source

	annotation PBI_ResultType = Table

