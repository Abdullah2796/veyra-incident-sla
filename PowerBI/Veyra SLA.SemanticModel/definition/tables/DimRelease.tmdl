table DimRelease

	column Release
		dataType: string
		summarizeBy: none
		sourceColumn: Release

	column 'Release Date'
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: Release Date

	column Type
		dataType: string
		summarizeBy: none
		sourceColumn: Type

	partition DimRelease = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "release_calendar.csv"), [Delimiter = ",", Encoding = 65001]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Release", type text}, {"Release Date", type date}, {"Type", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

